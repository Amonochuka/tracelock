# TraceLock backend configuration
# Copy to .env and fill in real values. NEVER commit the real .env.

# ── Required ──────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=tracelock
JWT_SECRET=change-me-to-a-long-random-string
DEVICE_API_KEY=change-me-device-key

# ── Optional ──────────────────────────────────────────────────────────────
PORT=8080
DB_SSLMODE=disable
ALLOWED_ORIGIN=http://localhost:3000
SESSION_TIMEOUT_HOURS=12

# ── Demo guardian (optional, public demos only) ───────────────────────────
# When both are set, a background job restores this account every interval:
# re-creates it if missing, keeps role=admin, clears lockouts, resets the
# password. Leave both unset outside public demos.
# DEMO_ADMIN_EMAIL=admin@tracelock.io
# DEMO_ADMIN_PASSWORD=published-demo-password
# DEMO_ADMIN_INTERVAL_SECONDS=30

# ── Render / production variant ───────────────────────────────────────────
# Render Postgres external hostname looks like dpg-xxxx-a.oregon-postgres.render.com.
# Set these in the Render dashboard (Environment tab), never in git:
#
#   DB_HOST=dpg-xxxx-a.oregon-postgres.render.com
#   DB_PORT=5432
#   DB_USER=<render_db_user>
#   DB_PASSWORD=<render_db_password>
#   DB_NAME=<render_db_name>
#   DB_SSLMODE=require                      # TLS is mandatory off-box
#   ALLOWED_ORIGIN=https://your-frontend.onrender.com   # exact origin, no trailing slash
#   JWT_SECRET=<long-random-secret>         # rotate before going live
#   DEVICE_API_KEY=<device-key>
#
# Notes:
# - ALLOWED_ORIGIN must match the frontend origin exactly (wildcards break CORS).
# - godotenv loads .env automatically; on Render use dashboard env vars instead.
# - Existing env vars always win over .env values (godotenv does not override).
