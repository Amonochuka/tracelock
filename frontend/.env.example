# TraceLock frontend configuration — all variables optional.
# Copy to .env.local for local overrides. Never commit real secrets.

# Point the frontend at a specific API host. Leave unset to auto-derive the
# API/WebSocket base from the browser address (works for localhost:8080 and
# same-host LAN setups without configuration).
# NEXT_PUBLIC_API_URL=http://localhost:8080

# Render / production variant: set in the Render dashboard when the API lives
# on a different host than the page:
#   NEXT_PUBLIC_API_URL=https://your-api-host.onrender.com
